# shellcheck shell=bash

[[ $- == *i* ]] || return

for shell_file in \
    "$HOME/.config/shell/aliases.sh" \
    "$HOME/.config/shell/functions.sh" \
    "$HOME/.config/shell/bash.bash"
do
    [[ -r "$shell_file" ]] && source "$shell_file"
done
unset shell_file

case "$(uname -s 2>/dev/null)" in
    Darwin)
        bash_platform=darwin.bash
        ;;
    Linux)
        bash_platform=linux.bash
        ;;
    MINGW*|MSYS*|CYGWIN*)
        bash_platform=git-bash.bash
        ;;
    *)
        bash_platform=
        ;;
esac

if [[ -n "$bash_platform" && -r "$HOME/.config/shell/$bash_platform" ]]; then
    source "$HOME/.config/shell/$bash_platform"
fi
unset bash_platform

[[ -r "$HOME/.config/shell/local.bash" ]] && source "$HOME/.config/shell/local.bash"
